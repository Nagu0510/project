# SkillSense AI backend settings. Copy this file to backend/.env and fill in the REQUIRED values.
# backend/.env is git-ignored: never commit it, never paste its values into chat, tickets or screenshots.
# Every value below is a placeholder.

# ---------------------------------------------------------------- REQUIRED
# Local MongoDB: mongodb://localhost:27017
# Atlas: Atlas > Connect > Drivers, then replace <user>, <password> and <cluster>
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# At least 32 random characters. The app refuses to start without it. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------- GENERAL
# development | test | production. In production: /docs is off, CORS allows FRONTEND_URL only, demo accounts must be off.
ENV=development
PROJECT_NAME=SkillSense AI
API_V1_STR=/api
DATABASE_NAME=skillsense_ai
# The address of the frontend (used for CORS and for links in emails)
FRONTEND_URL=http://localhost:5173
# Minimum TF-IDF similarity (0 to 1) for "this question was asked before"
SIMILARITY_THRESHOLD=0.80

# ---------------------------------------------------------------- SIGN-IN AND SECURITY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password hashing cost. 12 is right for real use; tests use a lower value.
BCRYPT_ROUNDS=12
# Rate limits (slowapi syntax: count/second|minute|hour)
AUTH_RATE_LIMIT=10/minute
REFRESH_RATE_LIMIT=60/minute
RESUME_RATE_LIMIT=12/minute
CODE_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=10/minute
EXPORT_RATE_LIMIT=6/minute

# Google sign-in (students only): an OAuth "Web application" client from Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 and http://127.0.0.1:5173. Empty = the Google button is hidden.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- CODE RUNNER (practice arena)
# online (default): a hosted compiler API called only from this backend. Needs internet, no Docker, no compilers.
# subprocess: runs code on this machine (development only, NOT a security boundary). docker: real isolation, needs Docker.
SANDBOX_MODE=online
# judge0_ce (free public instance, no key) | judge0_rapidapi (needs CODE_API_KEY) | judge0 (your server, needs CODE_API_URL) | piston (your server)
CODE_PROVIDER=judge0_ce
CODE_API_URL=
CODE_API_KEY=
# Seconds to wait for one request to the compiler provider
CODE_REQUEST_TIMEOUT=15
# How many programs may run at the same time on this server
SANDBOX_MAX_CONCURRENT=4

# ---------------------------------------------------------------- RESUME OCR
# For scanned PDFs and photos: rapidocr (default, installed by pip) or tesseract (also needs the Tesseract program)
OCR_ENGINE=rapidocr

# ---------------------------------------------------------------- EMAIL (Gmail SMTP)
# Needs 2-Step Verification and an App Password: https://myaccount.google.com/apppasswords
# While EMAIL_ENABLED=false nothing is sent (the message type is logged; in development the link is printed).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------- DEVELOPMENT ONLY (must stay false in production)
# Start without MongoDB on a throwaway in-memory database (all data is lost on restart)
ENABLE_MEMORY_FALLBACK=false
