ENV=development
# Local: mongodb://localhost:27017   Atlas: the mongodb+srv:// string from Atlas > Connect > Drivers
MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=skillsense_ai
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_random_string_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
SIMILARITY_THRESHOLD=0.80
# Code runner. online (default): hosted compiler API, no Docker or local compilers, needs internet.
SANDBOX_MODE=online
# judge0_ce (free, no key) | judge0_rapidapi (needs CODE_API_KEY) | judge0 (your server, CODE_API_URL) | piston (your server, CODE_API_URL)
CODE_PROVIDER=judge0_ce
CODE_API_URL=
CODE_API_KEY=
ENABLE_DEMO_ACCOUNTS=false
# Only used when ENV=development and ENABLE_DEMO_ACCOUNTS=true
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Development only: allow starting without MongoDB (data lost on restart)
ENABLE_MEMORY_FALLBACK=false

# Google sign-in (students). Create an OAuth "Web application" client in Google Cloud Console
# and add your frontend origin (e.g. http://localhost:5173) to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Email (Gmail SMTP). Needs 2-Step Verification and an App Password: https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=

# Resume OCR for scanned PDFs and photos: rapidocr (default, pip package) or tesseract (needs the program installed)
OCR_ENGINE=rapidocr
