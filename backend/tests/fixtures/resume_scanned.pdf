яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя&&&hhhяяяяяяяяяяяяяяяяяяяяяяяяяяяЎЎЎ°°°яяяяяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяхххwwwґґґяяяяяяПППЦЦЦяяяяяя%%%‡‡‡яяяяяяяяяяяяяяяяяяСССПППяяяяяяЛЛЛЪЪЪяяяяяяяяяяяяяяяЛЛЛЪЪЪяяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя111{{{яяяяяяяяяяяяяяяяяяАААррряяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяµµµррряяяяяяяяяяяяяяяяяяяяяЕЕЕ'''ОООяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя111{{{яяяяяяяяяяяяяяяяяяАААррряяяяяяkkk’’’сссяяяяяяяяяяяя°°°вввяяяяяяяяяGGGwwwяяяяяяяяяяяяkkk’’’сссяяяяяяяяяяяя°°°вввяяяяяяИИИзззяяяяяяяяяяяяяяяяяяTTT]]]яяяяяяkkk’’’сссяяяяяяяяяяяя°°°вввяяяяяяяяяяяяяяяяяяяяяяяяяяяхххwwwґґґяяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяGGGwwwяяяяяяяяяяяяkkk’’’сссяяяяяяяяяяяя°°°вввяяяяяяИИИзззяяяяяяяяяяяяяяяяяяTTT]]]яяяяяяАААйййяяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяхххwwwґґґяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяkkk’’’сссяяяяяяяяяяяя°°°вввяяяяяяЛЛЛЪЪЪяяяяяяяяяяяяяяяЛЛЛЪЪЪяяяяяя111{{{яяяяяяяяяяяяяяяяяяАААррряяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяННН,,,яяяIIIУУУяяячччТТТ{{{‡‡‡яяяяяяяяяяяяДДДвввяяяяяяяяяяяяяяя%%%ЂЂЂяяяяяяяяяяяяяяяяяяяяяggg999яяяяяяяяяGGGwwwяяяяяяяяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяЕЕЕ'''ОООяяяяяяяяяяяяяяяяяяяяяяяяCCCOOOяяяяяяяяяяяяяяяяяяяяяGGGSSSяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяttt###шшшяяяяяяяяяяяяяяяяяяяяяяяяяяя+++ЂЂЂяяяяяяццц###UUUяяяяяяяяяяяяяяянннFFFіііюююяяяччч(((GGGяяяяяяяяяыыы‚‚‚яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя;;;sssяяяяяяяяяяяяяяяяяяИИИннняяяяяяГГГгггяяяяяяяяяяяяяяяЎЎЎннняяяяяя777bbbяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяДДДвввяяяяяяяяяяяяяяяППП