яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя111vvvъъъяяяяяяяяяяяяyyy(((щщщяяяяяяяяяяяяяяящщщ'''‹‹‹яяяяяяkkk???яяяяяяяяяяяяяяяяяяpppррряяяяяяАААйййяяяяяяяяяяяяяяя№№№ннняяяяяяЊЊЊ###шшшяяяяяяяяяяяяяяя•••000]]]яяяяяяyyy(((щщщяяяяяяяяяяяяяяящщщ'''‹‹‹яяяяяяkkk???яяяяяяяяяяяяяяяяяяpppррряяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяЭЭЭћћћяяяяяяяяяяяяEEE///эээяяяяяяяяяяяяяяя&&&hhhяяяяяяяяяяяяяяяфффНННsss111щщщяяяяяяяяяЌЌЌннняяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяДДДЎЎЎяяяяяяяяяяяяяяяyyy(((щщщяяяяяяяяяяяяяяящщщ'''‹‹‹яяяяяяTTTSSSюююяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяЛЛЛЌЌЌяяяяяяяяяяяяяяяшшш###ЊЊЊяяяяяя^^^888юююяяяяяяяяяяяяяяящщщ&&&pppяяяяяяЛЛЛ”””яяяяяяяяяяяяяяяІІІгггяяяяяяTTTSSSюююяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяyyy(((щщщяяяяяяяяяяяяяяящщщ'''‹‹‹яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяGGGwwwяяяяяяяяяяяяПППЦЦЦяяяяяяЛЛЛЏЏЏяяяяяяяяяяяяэээYYYяяяяяяяяяяяяяяя```UUUяяяяяяyyy(((щщщяяяяяяяяяяяяяяящщщ'''‹‹‹яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяИИИяяяяяяяяяяяяяяяццц   ЉЉЉяяяяяящщщ"""ЌЌЌяяяяяяяяяяяяjjjpppяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяязззrrrчччяяяяяяяяяјјј;;;%%%РРРяяяяяяяяяяяяяяяtttГГГяяяяяяяяяяяя®®®>>>,,,ЂЂЂчччяяяяяяPPPПППяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяИИИяяяяяяяяяяяяяяяццц   ЉЉЉяяяяяящщщ"""ЌЌЌяяяяяяяяяяяяjjjpppяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя¦¦¦999???яяяяяяяяяяяяяяяяяяЄЄЄжжжяяяяяяkkk???яяяяяяяяяяяяяяяяяяpppррряяяяяяkkk???яяяяяяяяяяяяяяяяяяpppррряяяяяяПППЦЦЦяяяяяяЛЛЛ”””яяяяяяяяяяяяяяяІІІгггяяяяяяiiiDDDяяяяяяяяяяяяяяяяяя………ПППяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя111