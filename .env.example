# API base URL. Default "/api" uses the Vite dev proxy (-> http://127.0.0.1:8000) so the
# httpOnly refresh cookie works. In production serve the API on the same site (e.g. behind
# the same domain or a sibling subdomain) and set the full URL if it is on another host.
VITE_API_BASE_URL=/api

# Same value as the backend GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
